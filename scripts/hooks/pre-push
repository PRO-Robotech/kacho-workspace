#!/usr/bin/env bash
# Copyright (c) PRO-Robotech
# SPDX-License-Identifier: BUSL-1.1
#
# pre-push — локальные проверки воркспейса перед отправкой ветки.
#
# ПОЧЕМУ ОН ЗАВЁЛСЯ. Переходник в `.git/hooks/pre-push` здесь уже стоял и звал
# `scripts/hooks/pre-push`, которого в дереве НЕ БЫЛО. Переходник в этом случае
# печатает «проверок НЕ БЫЛО» и выходит УСПЕХОМ — то есть провязка выглядела
# исполненной, отправка проходила, и ни одна ветка воркспейса ни разу не была
# проверена локально. Форма контроля без содержания, ровно та, которую корпус
# ловит в продукте.
#
# ОКРУЖЕНИЕ GIT НЕ НАСЛЕДУЕТСЯ ПРОВЕРКАМИ — тот же класс, что и в монорепо.
# `git push` запускает хук с выставленным `GIT_DIR`, и его наследует ВСЁ, что
# хук запускает. Переменная сильнее рабочего каталога, поэтому любая проверка,
# заводящая свой репозиторий во временном каталоге, начинает писать в ЭТУ
# рабочую копию: индекс схлопывается, а падают потом проверки, ни к чему не
# причастные, — с сообщением «прочитано ноль». Перечень снимаемого совпадает с
# перечнем монорепо (`internal/gitenv`), и это совпадение там проверяется
# пробой; здесь оно держится вниманием, потому что общего кода у двух
# репозиториев нет.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY \
      GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR GIT_PREFIX

set -uo pipefail

# ── ЧТО ОТПРАВЛЯЕТСЯ — ЧИТАЕТСЯ ПЕРВЫМ ДЕЛОМ И ЦЕЛИКОМ ────────────────────────
#
# Git подаёт хуку на stdin строки «<локальная ссылка> <sha> <удалённая ссылка>
# <sha на сервере>». Читаются они до всего остального: наборы ниже наследуют тот
# же stdin и способны его съесть. Чтение ограничено по времени и не трогает
# терминал: хук, запущенный не из `git push` (руками, из пробы `check-08`),
# иначе ВИС бы на неоконченном потоке; у git поток закрывается сразу.
push_lines=()
if [ ! -t 0 ]; then
    while IFS= read -r -t 2 line; do
        [ -n "$line" ] && push_lines+=("$line")
    done
fi
PUSH_REMOTE="${1:-}"

ROOT="$(git rev-parse --show-toplevel)" || exit 1
cd "$ROOT" || exit 1

# ── ПОДПИСЬ И ВЕДОМОСТЬ: судится ОТПРАВЛЯЕМЫЙ ДИАПАЗОН (ws#729, ws#700) ────────
#
# Подпись коммита чинится в настройке, а настройка переписываема и разделяема
# всеми рабочими копиями, и адрес окружения сильнее её: `git config user.email`
# отвечает правду о конфиге и ничего — о том, чем подписан коммит. Поэтому
# судится то, что отправка ОПУБЛИКУЕТ: коммиты, которых на сервере ещё нет,
# автор, коммиттер и соавторы каждого — против ведомости `contribution-ledger.yaml`,
# той же, что судит гейт дерева (`scripts/cla-gate`); второго перечня личностей нет.
# После отправки цена ошибки — перезапись опубликованного, поэтому здесь, а не
# в конвейере.
#
# Суждение ДЕШЁВОЕ и стоит ПЕРВЫМ: ни черновая ветка, ни KACHO_SKIP_PREPUSH его не
# снимают — они про наборы проверок, а не про то, чьей подписью уйдёт коммит.
# Обход один и явный: `git push --no-verify`.
#
# FAIL-CLOSED. Исход 2 разборщика («условие не создано»: ведомости нет, git не
# ответил) здесь — отказ: проверить было нечем, и это не проход (ws#729 п.2).
if [ "${#push_lines[@]}" -gt 0 ]; then
    judge="$ROOT/scripts/cla-gate/cla.py"
    if [ ! -f "$judge" ] || ! command -v python3 >/dev/null; then
        echo "pre-push: ОТКАЗ — подпись отправляемых коммитов судить нечем:" >&2
        echo "  нет $judge либо python3. Условие не создано — это не проход." >&2
        echo "  Обход только явный: git push --no-verify" >&2
        exit 1
    fi
    python3 "$judge" push-range --root "$ROOT" --remote "$PUSH_REMOTE" \
        <<<"$(printf '%s\n' "${push_lines[@]}")"
    judged=$?
    if [ "$judged" -ne 0 ]; then
        echo "pre-push: ОТКАЗ — отправка остановлена суждением по диапазону (код $judged)." >&2
        echo "  Обход только явный и в отчёте: git push --no-verify" >&2
        exit 1
    fi
    identity_note="подпись и ведомость отправляемых коммитов — суждены"
else
    identity_note="подпись и ведомость НЕ судились: отправляемый диапазон не подан (запуск не из git push)"
    echo "pre-push: $identity_note" >&2
fi

if [ "${KACHO_SKIP_PREPUSH:-0}" = "1" ]; then
    echo "pre-push: наборы пропущены по KACHO_SKIP_PREPUSH=1 — локальные проверки НЕ выполнялись ($identity_note)" >&2
    exit 0
fi

# Ветка, которую никто не собирается вливать, наборов не требует.
branch="$(git rev-parse --abbrev-ref HEAD)"
case "$branch" in
    wip/*|tmp/*)
        echo "pre-push: ветка «$branch» объявлена черновиком — наборы пропущены ($identity_note)" >&2
        exit 0
        ;;
esac

# ── Соседние дома: ВЫВОДЯТСЯ из канонического клона, а не гадаются (ws#747) ──
#
# Часть проверок сверяет утверждения воркспейса с деревьями продукта и без них
# честно объявляет себя БЕЗ ПРЕДМЕТА (VOID) — «не выполнилось», третья категория,
# которая в успех не засчитывается. Рабочая копия полосы (`tmp/<полоса>`) —
# штатное место отправки, а соседних клонов рядом с ней нет: они лежат у
# КАНОНИЧЕСКОГО клона, в его `project/<имя>`. Выводилось прежде только дерево
# продукта (`KACHO_MONOREPO`), и из копии без предмета оставались наборы, которым
# нужны остальные дома, — при каждой отправке, то есть весь класс.
#
# Вывод — из общего каталога репозитория (`--git-common-dir` указывает внутрь
# канонического клона): каждая рабочая копия git в `<канонический>/project/*`
# становится `KACHO_HOME_<ИМЯ>` — той переменной, которую читают наборы
# (crossrepo-gate, docs-gate, change-graph-gate). Перечень домов ВЫВОДИТСЯ из
# каталога, а не выписывается. Идентичность копии (её origin) судит сам набор, а
# не хук: подставленный путь, ведущий не туда, набор отвергнет с названной причиной.
# Заданное снаружи не перебивается. Не вывелось ничего — ничего не подставляем:
# пусть проверка сама скажет, чего ей не хватило.
#
# «Отправлять из канонического клона» — НЕ лечение: хук судит дерево своего
# рабочего каталога, и отправка ветки полосы оттуда исполнила бы все наборы по
# ЧУЖОМУ содержимому — зелёными и о не том предмете.
common="$(git rev-parse --git-common-dir 2>/dev/null || true)"
case "$common" in /*) ;; *) common="$ROOT/$common" ;; esac
canonical="$(cd "$(dirname "$common")" 2>/dev/null && pwd -P)" || canonical=""
homes=0
for d in "${canonical:-/nonexistent}"/project/*/; do
    d="${d%/}"
    [ -e "$d/.git" ] || continue
    name="${d##*/}"
    up="${name^^}"
    var="KACHO_HOME_${up//[^A-Z0-9]/_}"
    homes=$((homes + 1))
    if [ -n "${!var:-}" ]; then
        echo "pre-push: дом $name задан снаружи — $var=${!var}" >&2
    else
        export "$var=$d"
        echo "pre-push: дом $name выведен — $d ($var)" >&2
    fi
    if [ "$name" = kacho ] && [ -z "${KACHO_MONOREPO:-}" ]; then
        export KACHO_MONOREPO="${!var}"
    fi
done
if [ "$homes" -eq 0 ]; then
    echo "pre-push: соседних домов у канонического клона нет (${canonical:-?}/project/*) — наборы, которым они нужны, скажут VOID сами" >&2
fi

# ── Перечень ВЫВОДИТСЯ из дерева, а не выписывается ──────────────────────────
#
# Рукописный список разъезжается с деревом молча: заведут пятый набор проверок,
# и он не будет исполняться, а хук продолжит рапортовать успех. Признак —
# место и имя: `scripts/<набор>/run-all.sh`, отслеживаемый git.
gates=()
while IFS= read -r rel; do
    gates+=("$rel")
done < <(git ls-files 'scripts/*/run-all.sh' | sort)

if [ "${#gates[@]}" -eq 0 ]; then
    echo "pre-push: ОТКАЗ — в дереве нет НИ ОДНОГО scripts/*/run-all.sh." >&2
    echo "Пустой обход здесь означал бы зелёную отправку при снятых проверках." >&2
    exit 1
fi

# ── ТРИ ИСХОДА НАБОРА, А НЕ ДВА ──────────────────────────────────────────────
#
# Прогонщик отвечает: 0 — чисто; 1 — НАХОДКА; 2 — БЕЗ ПРЕДМЕТА (часть проверок
# не с чем было сверять — нет клона продукта, нет разборщика, нет инструмента).
#
# Третья категория НЕ красная и НЕ зелёная. Блокировать отправку из-за неё
# нельзя: в свежем клоне воркспейса `project/kacho` нет вовсе, и до 2026-08-30
# КАЖДАЯ отправка оттуда получала единицу — красное, приходящее всегда и по
# причине, к дереву не относящейся. Такое красное перестают читать, а вместе с
# ним перестают читать настоящие находки (ws#458).
#
# Засчитывать её за успех тоже нельзя, поэтому она называется отдельной строкой
# и поимённо, а завершающая строка хука на ней ДРУГАЯ: «зелёные» говорится
# только про то, что действительно проверено.
#
# Это НЕ маска: находка объявляется первой и самим прогонщиком. Набор, где есть
# и находка, и беспредметная проверка, отвечает единицей и отправку остановит.
#
# ДЕРЖИТСЯ ЭТО НЕ КОММЕНТАРИЕМ, а поведенческой пробой
# `scripts/tooling-gate/check-08-caller-reads-the-three-outcomes.sh`: она кладёт
# рядом с копией хука прогонщики с ЗАДАННЫМИ кодами и требует четырёх исходов —
# всё зелено даёт 0, находка даёт 1, беспредметность даёт 0 и завершается строкой,
# ОТЛИЧНОЙ от строки чистого прогона, а находка рядом с беспредметностью снова
# даёт 1. Соседи `check-04` и `check-07` судят только прогонщиков и об этом
# файле не говорят ничего.
# ── ГРАНИЦА ЗЕЛЁНОГО ПЕЧАТАЕТСЯ, А НЕ ЛЕЖИТ КОММЕНТАРИЕМ (ws#751 п.4) ─────────
#
# Две величины, и они не смешиваются: КАТЕГОРИЯ исхода (провалено 0 — зелёная) и
# ОСИ, не спрошенные внутри неё. Вторая из вердикта не вычитается и зелёного не
# отменяет, но и за проверенное не выдаётся. Здесь она стояла комментарием, то
# есть читал её только тот, кто открыл файл, а «локально зелено» читалось как
# «проверено всё». Печатается ДО завершающей строки: последняя строка чистого
# прогона обязана отличаться от последней строки беспредметного, и это свойство
# держит `scripts/tooling-gate/check-08-caller-reads-the-three-outcomes.sh`.
# ПОСТУСЛОВИЕ ОТПРАВКИ — НЕ УКРАШЕНИЕ ВЫВОДА (ws#776). Между `git push` и его
# исходом всегда стоит посредник, и код возврата говорит О ПОСРЕДНИКЕ: замеры
# 2026-09-22 — `exit code 0` при настоящем 128 (соединение оборвали по простою
# длинного хука) и `exit code 0` от харнесса, переведшего команду в фон. Поэтому
# хук называет СВОЙ код своим и печатает то, чем отправка проверяется на самом
# деле: ссылка на сервере равна отправленной sha.
postcondition_note() {
    echo "pre-push: код ЭТОГО хука — исход ПРОВЕРОК, а не отправки." >&2
    local remote="${PUSH_REMOTE:-origin}" line lsha rref
    if [ "${#push_lines[@]}" -eq 0 ]; then
        echo "  Что отправляется, хук не прочитал — подтверждайте сами: git ls-remote $remote <ссылка>" >&2
    else
        echo "  Отправка состоялась, только если ссылка на сервере равна отправленной sha:" >&2
        for line in "${push_lines[@]}"; do
            read -r _ lsha rref _ <<<"$line"
            [ "$lsha" = 0000000000000000000000000000000000000000 ] && continue
            echo "    git ls-remote $remote $rref   # ожидается $lsha" >&2
        done
    fi
    echo "  Обёртка, которая делает это сама: bash scripts/push-verified.sh $remote <ветка>" >&2
}

boundary() {
    postcondition_note
    echo "pre-push: $identity_note" >&2
    echo "pre-push: здесь НЕ проверялось —" >&2
    echo "  · scripts/hook-proofs.sh (доказательства инъекцией у хуков .claude): набор" >&2
    echo "    красный на стволе, и красный набор в отправке остановил бы всех; войдёт," >&2
    echo "    когда позеленеет;" >&2
    echo "  · содержимое ОТПРАВЛЯЕМОЙ ссылки: наборы судят рабочее дерево этой копии," >&2
    echo "    а не отправляемую sha — отправка чужой ветки отсюда судит не её;" >&2
    echo "  · монорепо продукта: у него свой хук в своей рабочей копии." >&2
}

failed=()
void=()
for g in "${gates[@]}"; do
    printf '── %s\n' "$g" >&2
    bash "$ROOT/$g" >&2
    case $? in
        0) ;;
        2) void+=("$g") ;;
        *) failed+=("$g") ;;
    esac
done

echo "pre-push: исполнено наборов ${#gates[@]}, провалено ${#failed[@]}, без предмета ${#void[@]}" >&2

if [ "${#failed[@]}" -gt 0 ]; then
    echo "" >&2
    echo "ОТКАЗ: отправка остановлена. Красные наборы:" >&2
    printf '  %s\n' "${failed[@]}" >&2
    echo "" >&2
    echo "Обойти можно, но осознанно и с этой строкой в отчёте:" >&2
    echo "  KACHO_SKIP_PREPUSH=1 git push …   (или git push --no-verify)" >&2
    exit 1
fi

if [ "${#void[@]}" -gt 0 ]; then
    echo "" >&2
    echo "БЕЗ ПРЕДМЕТА (не выполнилось, в успех НЕ засчитано) — наборы:" >&2
    printf '  %s\n' "${void[@]}" >&2
    echo "Причину называет сам набор строкой [VOID]. Чаще всего это отсутствие" >&2
    echo "соседнего клона: заведите его в project/<имя> канонического клона" >&2
    echo "(выводится сам, строкой «дом … выведен» выше) либо задайте KACHO_HOME_<ИМЯ>." >&2
    echo "Отправка НЕ остановлена: условие не создано — это не находка о дереве." >&2
    echo "В конвейере клон выкладывается шагом, и там тот же код 2 роняет job." >&2
    boundary
    echo "pre-push: часть проверок БЕЗ ПРЕДМЕТА — «зелёного» о них не сказано" >&2
    exit 0
fi

boundary
echo "pre-push: локальные проверки воркспейса зелёные" >&2
exit 0
