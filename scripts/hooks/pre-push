#!/usr/bin/env bash
# Copyright (c) PRO-Robotech
# SPDX-License-Identifier: BUSL-1.1
#
# pre-push — локальные проверки воркспейса перед отправкой ветки.
#
# ПОЧЕМУ ОН ЗАВЁЛСЯ. Переходник в `.git/hooks/pre-push` здесь уже стоял и звал
# `scripts/hooks/pre-push`, которого в дереве НЕ БЫЛО. Переходник в этом случае
# печатает «проверок НЕ БЫЛО» и выходит УСПЕХОМ — то есть провязка выглядела
# исполненной, отправка проходила, и ни одна ветка воркспейса ни разу не была
# проверена локально. Форма контроля без содержания, ровно та, которую корпус
# ловит в продукте.
#
# ОКРУЖЕНИЕ GIT НЕ НАСЛЕДУЕТСЯ ПРОВЕРКАМИ — тот же класс, что и в монорепо.
# `git push` запускает хук с выставленным `GIT_DIR`, и его наследует ВСЁ, что
# хук запускает. Переменная сильнее рабочего каталога, поэтому любая проверка,
# заводящая свой репозиторий во временном каталоге, начинает писать в ЭТУ
# рабочую копию: индекс схлопывается, а падают потом проверки, ни к чему не
# причастные, — с сообщением «прочитано ноль». Перечень снимаемого совпадает с
# перечнем монорепо (`internal/gitenv`), и это совпадение там проверяется
# пробой; здесь оно держится вниманием, потому что общего кода у двух
# репозиториев нет.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY \
      GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR GIT_PREFIX

set -uo pipefail

if [ "${KACHO_SKIP_PREPUSH:-0}" = "1" ]; then
    echo "pre-push: пропущен по KACHO_SKIP_PREPUSH=1 — локальные проверки НЕ выполнялись" >&2
    exit 0
fi

ROOT="$(git rev-parse --show-toplevel)" || exit 1
cd "$ROOT" || exit 1

# ── Вход отправки: ЧТО уезжает, а не где стоит копия ─────────────────────────
#
# git подаёт на stdin по строке на ссылку: `<local ref> <local sha> <remote ref>
# <remote sha>`. Нулевой `<local sha>` — снятие ссылки: ревизий в нём нет, и
# судить копию значило бы решать исход снятия её незакоммиченной правкой (ws#810).
# Пустой вход (ручной вызов) за «только удаления» НЕ считается. Проверки
# влитости снимаемой головы здесь нет: перепись веток — `scripts/branch-audit.sh`.
# Держит это `scripts/tooling-gate/check-10-push-hook-judges-what-is-pushed.sh`.
is_null_sha() { case "$1" in '' | *[!0]*) return 1 ;; esac; }
pushed=()
removed=()
if [ ! -t 0 ]; then
    while read -r _lref lsha rref rsha || [ -n "${lsha:-}" ]; do
        [ -n "${lsha:-}" ] || continue
        if is_null_sha "$lsha"; then
            removed+=("$rref (была ${rsha:0:12})")
        else
            pushed+=("$rref $lsha")
        fi
    done
fi
n_removed=${#removed[@]}
n_pushed=${#pushed[@]}
if [ "$n_removed" -gt 0 ] && [ "$n_pushed" -eq 0 ]; then
    printf 'pre-push: снимается ссылок %s: %s\n' "$n_removed" "${removed[*]}" >&2
    echo "pre-push: только удаление, прогона не было" >&2
    exit 0
fi

# ── Дерево продукта: ВЫВОДИМ, а не гадаем ────────────────────────────────────
#
# Часть проверок сверяет утверждения воркспейса с деревом монорепо и без него
# честно объявляет себя БЕЗ ПРЕДМЕТА (VOID) — то есть «не выполнилось», третья
# категория, которая в успех не засчитывается. Из рабочей копии-worktree
# `project/kacho` рядом не лежит, поэтому VOID получала бы каждая отправка.
#
# Путь берётся из общего каталога репозитория (`--git-common-dir` указывает
# внутрь КАНОНИЧЕСКОГО клона, где `project/kacho` и лежит) — это вывод, а не
# зашитая координата машины. Не вывелось — ничего не подставляем: пусть
# проверка сама скажет, чего ей не хватило.
common="$(git rev-parse --git-common-dir 2>/dev/null || true)"
case "$common" in /*) ;; *) common="$ROOT/$common" ;; esac
canonical="$(dirname "$common")"
if [ -z "${KACHO_MONOREPO:-}" ]; then
    if [ -d "$canonical/project/kacho/.git" ] || [ -f "$canonical/project/kacho/.git" ]; then
        export KACHO_MONOREPO="$canonical/project/kacho"
        echo "pre-push: дерево продукта выведено — $KACHO_MONOREPO" >&2
    fi
fi

# ── Что судится: дерево КАЖДОЙ отправляемой вершины, а не копия (ws#811) ─────
#
# Вершина судится во временной копии на её ревизии: незакоммиченное в исход не
# входит, а красная вершина не уезжает оттого, что копия зелёная. Черновик
# (`wip/*`, `tmp/*`) — по ОТПРАВЛЯЕМОЙ ссылке, а не по HEAD. Пустой вход судит
# HEAD. Держит это `scripts/tooling-gate/check-10-push-hook-judges-what-is-pushed.sh`.
targets=()
if [ "$n_pushed" -eq 0 ]; then
    head="$(git rev-parse --verify -q 'HEAD^{commit}')" || {
        echo "pre-push: ОТКАЗ — вход отправки пуст, а HEAD не родился: судить нечего." >&2
        exit 1
    }
    echo "pre-push: вход отправки пуст — судится HEAD" >&2
    targets+=("HEAD $head")
fi
for e in "${pushed[@]}"; do
    rref="${e% *}"
    name="${rref#refs/heads/}"
    case "$name" in
        wip/* | tmp/*)
            echo "pre-push: ссылка «$rref» объявлена черновиком — проверки пропущены" >&2
            continue
            ;;
    esac
    c="$(git rev-parse --verify -q "${e##* }^{commit}")" || {
        echo "pre-push: ОТКАЗ — вершина «$rref» (${e##* }) не сводится к ревизии." >&2
        exit 1
    }
    targets+=("$rref $c")
done
if [ "${#targets[@]}" -eq 0 ]; then
    echo "pre-push: уезжают только черновики — проверки пропущены" >&2
    exit 0
fi

wt_base="$canonical/tmp"
wts=()
# shellcheck disable=SC2317,SC2329  # зовётся ловушкой EXIT
cleanup() {
    local w
    for w in "${wts[@]}"; do
        git worktree remove --force "$w" >/dev/null 2>&1 || rm -rf "$w"
    done
    [ "${#wts[@]}" -eq 0 ] || git worktree prune >/dev/null 2>&1
}
trap cleanup EXIT

# ── ТРИ ИСХОДА НАБОРА, А НЕ ДВА ──────────────────────────────────────────────
#
# Прогонщик отвечает: 0 — чисто; 1 — НАХОДКА; 2 — БЕЗ ПРЕДМЕТА (часть проверок
# не с чем было сверять — нет клона продукта, нет разборщика, нет инструмента).
#
# Третья категория НЕ красная и НЕ зелёная. Блокировать отправку из-за неё
# нельзя: в свежем клоне воркспейса `project/kacho` нет вовсе, и до 2026-08-30
# КАЖДАЯ отправка оттуда получала единицу — красное, приходящее всегда и по
# причине, к дереву не относящейся. Такое красное перестают читать, а вместе с
# ним перестают читать настоящие находки (ws#458).
#
# Засчитывать её за успех тоже нельзя, поэтому она называется отдельной строкой
# и поимённо, а завершающая строка хука на ней ДРУГАЯ: «зелёные» говорится
# только про то, что действительно проверено.
#
# Это НЕ маска: находка объявляется первой и самим прогонщиком. Набор, где есть
# и находка, и беспредметная проверка, отвечает единицей и отправку остановит.
#
# ДЕРЖИТСЯ ЭТО НЕ КОММЕНТАРИЕМ, а поведенческой пробой
# `scripts/tooling-gate/check-08-caller-reads-the-three-outcomes.sh`: она кладёт
# рядом с копией хука прогонщики с ЗАДАННЫМИ кодами и требует четырёх исходов —
# всё зелено даёт 0, находка даёт 1, беспредметность даёт 0 и завершается строкой,
# ОТЛИЧНОЙ от строки чистого прогона, а находка рядом с беспредметностью снова
# даёт 1. Соседи `check-04` и `check-07` судят только прогонщиков и об этом
# файле не говорят ничего.
failed=()
void=()
ran=0
judged=()
for t in "${targets[@]}"; do
    rref="${t% *}"
    c="${t##* }"
    judged+=("$rref@${c:0:12}")
    if ! wt="$(mkdir -p "$wt_base" && mktemp -d "$wt_base/pre-push.XXXXXX")" ||
        ! wts+=("$wt") ||
        ! git -c core.hooksPath=/dev/null worktree add -q --detach "$wt" "$c" >/dev/null 2>&1; then
        echo "pre-push: ОТКАЗ — копию вершины «$rref» ($c) не собрать в $wt_base." >&2
        exit 1
    fi

    # ── Перечень ВЫВОДИТСЯ из дерева вершины, а не выписывается ─────────────
    #
    # Рукописный список разъезжается с деревом молча: заведут пятый набор
    # проверок, и он не будет исполняться, а хук продолжит рапортовать успех.
    # Признак — место и имя: `scripts/<набор>/run-all.sh`, отслеживаемый git.
    gates=()
    while IFS= read -r rel; do
        gates+=("$rel")
    done < <(git -C "$wt" ls-files 'scripts/*/run-all.sh' | sort)
    if [ "${#gates[@]}" -eq 0 ]; then
        echo "pre-push: ОТКАЗ — в дереве «$rref» нет НИ ОДНОГО scripts/*/run-all.sh." >&2
        echo "Пустой обход здесь означал бы зелёную отправку при снятых проверках." >&2
        exit 1
    fi
    for g in "${gates[@]}"; do
        printf '── %s @ %s: %s\n' "$rref" "${c:0:12}" "$g" >&2
        ran=$((ran + 1))
        (cd "$wt" && bash "$g" </dev/null) >&2
        case $? in
            0) ;;
            2) void+=("$rref: $g") ;;
            *) failed+=("$rref: $g") ;;
        esac
    done
done

echo "pre-push: судились вершины ${judged[*]}; исполнено наборов $ran, провалено ${#failed[@]}, без предмета ${#void[@]}" >&2

if [ "${#failed[@]}" -gt 0 ]; then
    echo "" >&2
    echo "ОТКАЗ: отправка остановлена. Красные наборы:" >&2
    printf '  %s\n' "${failed[@]}" >&2
    echo "" >&2
    echo "Обойти можно, но осознанно и с этой строкой в отчёте:" >&2
    echo "  KACHO_SKIP_PREPUSH=1 git push …   (или git push --no-verify)" >&2
    exit 1
fi

if [ "${#void[@]}" -gt 0 ]; then
    echo "" >&2
    echo "БЕЗ ПРЕДМЕТА (не выполнилось, в успех НЕ засчитано) — наборы:" >&2
    printf '  %s\n' "${void[@]}" >&2
    echo "Причину называет сам набор строкой [VOID]. Чаще всего это отсутствие" >&2
    echo "клона продукта: заведите его в project/kacho либо задайте KACHO_MONOREPO." >&2
    echo "Отправка НЕ остановлена: условие не создано — это не находка о дереве." >&2
    echo "В конвейере клон выкладывается шагом, и там тот же код 2 роняет job." >&2
    exit 0
fi

# ЧТО ЭТОТ ПРОГОН НЕ ПРОВЕРЯЕТ — названо, чтобы «локально зелено» не читалось
# шире исполненного:
#   · доказательства инъекцией у хуков (`scripts/hook-proofs.sh`) — набор красный
#     на стволе на 2026-08-16 (разошлись оба: class-guard и docfresh), и красный
#     гейт в отправке остановил бы всех. Он войдёт сюда, когда позеленеет;
#   · ничего из монорепо продукта — у него свой хук в своей рабочей копии.
echo "pre-push: локальные проверки воркспейса зелёные" >&2
exit 0
