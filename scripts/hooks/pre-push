#!/usr/bin/env bash
# Copyright (c) PRO-Robotech
# SPDX-License-Identifier: BUSL-1.1
#
# Хук отправки воркспейса: то, что можно узнать локально, узнаётся ДО отправки.
#
# ЗАЧЕМ ХУК, А НЕ ПУНКТ В РЕГЛАМЕНТЕ. Правило «прогоняй локально» существовало и
# соблюдалось ровно до первой спешки. Обещание держится гейтом, а не памятью — и
# именно этот клон показал цену: `core.hooksPath` указывал на каталог, которого
# нет, то есть провязка выглядела сделанной и не исполнялась НИ РАЗУ (#462).
#
# ЧТО ГОНЯЕТСЯ. Гейты самого воркспейса — те, что в нём и живут: оболочка и
# связность записок, перечень скилов, пути оснастки, состояние приёмок,
# исполнимость доказательств хуков. Это и есть «локальный прогон» воркспейса:
# конвейера у него нет вовсе, поэтому здесь он не дублируется, а замещается.
#
# ЧЕГО ЗДЕСЬ НЕТ. Продукта. Дерево `project/` под gitignore и к этому репозиторию
# не относится; его собственный хук живёт у него и гоняет его собственный
# прогонщик. Смешивать их значило бы отправлять записку по двадцать минут.
#
# КАК ОБОЙТИ И ПОЧЕМУ ЭТО ЗАКОННО. `git push --no-verify` либо
# `KACHO_SKIP_PREPUSH=1`. Обход нужен: отправка ветки-черновика ради обсуждения —
# законное действие. Но он ЯВНЫЙ: обойти можно, не заметив — нельзя.
#
# Установка: `bash scripts/hooks/install.sh install` — кладёт в `.git/hooks`
# переходник, исполняющий ЭТОТ файл из той рабочей копии, из которой идёт
# отправка. Проверить в любой момент: `bash scripts/hooks/install.sh check`.
set -uo pipefail

if [ "${KACHO_SKIP_PREPUSH:-0}" = "1" ]; then
    echo "pre-push: пропущен по KACHO_SKIP_PREPUSH=1 — локальные проверки НЕ выполнялись" >&2
    exit 0
fi

ROOT="$(git rev-parse --show-toplevel)"

# Ветка, которую никто не собирается вливать, проверок не требует: предмет хука —
# то, что поедет в запрос на слияние.
branch="$(git rev-parse --abbrev-ref HEAD)"
case "$branch" in
    wip/*|tmp/*)
        echo "pre-push: ветка «$branch» объявлена черновиком — проверки пропущены" >&2
        exit 0
        ;;
esac

echo "== pre-push: гейты воркспейса перед отправкой ветки «$branch»"
echo "   (обойти: git push --no-verify)"

# Перечень ВЫВОДИТСЯ ИЗ ДЕРЕВА ОДНИМ ПРИЗНАКОМ, а не выписывается: рукописный
# список уже однажды разошёлся сам с собой в трёх скриптах этого репозитория.
# Признак — место и имя: `scripts/<гейт>/run-all.sh`.
#
# ПОЧЕМУ ЗДЕСЬ НЕТ `scripts/hook-proofs.sh`, хотя он тоже прогонщик. Он не
# подпадает под признак, и дописать его отдельной строкой значило бы завести
# рукописное исключение рядом с выводимым перечнем — ровно ту форму, от которой
# уходили. Причина назвать это вслух, а не умолчать: на 2026-08-16 два из трёх
# его доказательств (`class-guard`, `docfresh`) на стволе РАСХОДЯТСЯ, то есть
# включение его сюда сделало бы хук красным в день заведения — а гейт, красный
# на приезде, снимают первым, вместе с тем, что он стерёг. Долг записан
# предметом, а не спрятан внутри условия. Появится признак, общий для обоих
# видов прогонщиков, — перечень расширится сам.
gates=()
while IFS= read -r g; do
    [ -n "$g" ] || continue
    gates+=("$g")
done < <(git -C "$ROOT" ls-files 'scripts/*/run-all.sh' | sort)

# НОЛЬ ЦЕЛЕЙ — ОТКАЗ, А НЕ УСПЕХ. Пустой обход здесь был бы неотличим от
# «всё зелено»: ровно так раскатка оснастки годами печатала «skip» и выходила
# нулём (см. `.claude/rules/ai-tooling.md`).
if [ "${#gates[@]}" -eq 0 ]; then
    echo "pre-push ОТКАЗ: не найдено НИ ОДНОГО гейта по признаку scripts/*/run-all.sh." >&2
    echo "Это отказ, а не «нечего проверять»: признак разошёлся с деревом." >&2
    exit 1
fi

ran=0; failed=()
for g in "${gates[@]}"; do
    ran=$((ran + 1))
    printf '\n== %s\n' "$g"
    if ! ( cd "$ROOT" && bash "$g" ); then
        failed+=("$g")
    fi
done

echo
echo "[CENSUS] pre-push: гейтов найдено ${#gates[@]}, исполнено $ran, красных ${#failed[@]}"

if [ "${#failed[@]}" -gt 0 ]; then
    cat >&2 <<MSG

pre-push ОТКАЗ: красные гейты — отправка остановлена:
  ${failed[*]}

Три исхода, четвёртого нет:
  почините найденное;
  снимите гейт вместе с предметом, который он стерёг;
  отправьте черновик явно — git push --no-verify.
MSG
    exit 1
fi

echo "== pre-push: гейты зелёные — отправляю"
