#!/usr/bin/env bash
# Copyright (c) PRO-Robotech
# SPDX-License-Identifier: BUSL-1.1
#
# commit-msg — сообщение коммита не несёт трейлеров атрибуции.
#
# ДЕРЖАТЕЛЬ ПРАВИЛА `gi-no-attribution-trailers` (`.claude/rules/git-issues.md`):
# подпись коммита берёт git-config репозитория, трейлеры `Co-Authored-By` и
# `Claude-Session` в сообщение не добавляются. До этого файла правило держалось
# вниманием, и провязка лгала о себе: переходник `.git/hooks/commit-msg` здесь
# уже стоял и звал `scripts/hooks/commit-msg`, которого в дереве не было, —
# печатал «проверок НЕ БЫЛО» и пропускал коммит. Тот же класс, из-за которого
# заводился соседний `pre-push`.
#
# ЧТО СУДИТСЯ. Строка сообщения, начинающаяся (после пробелов) с имени трейлера
# из перечня ATTRIBUTION и двоеточия, без учёта регистра — в любом абзаце, а не
# только в последнем: правило запрещает трейлер «в теле коммита», и git, не
# признав строку трейлером из-за места, всё равно опубликует её в `git log`.
#
# ЧТО НЕ СУДИТСЯ — то, что git сам выбрасывает до записи коммита:
#   · строки комментария: хук `commit-msg` получает файл ДО очистки, но
#     отдельной ветки на них нет — строка комментария начинается символом
#     `core.commentChar`, пробелом он быть не может, и якорь `^[[:space:]]*имя:`
#     её не узнаёт по построению (ветка пропуска оказалась мёртвой: снятие её
#     инъекцией не роняет ни одной пробы);
#   · всё ниже линии ножниц `>8` (`git commit -v`: там дифф, и строка контекста
#     дифа начинается ПРОБЕЛОМ — предмет правки, а не подпись). Линия ножниц
#     начинается символом `core.commentChar`, поэтому он читается из настройки.
# Упоминание имени трейлера в середине строки прозы трейлером не является и
# не судится: коммит, объясняющий это правило, законен.
#
# Обхода переменной окружения нет намеренно: `--no-verify` — только по явной
# просьбе владельца (`gi-no-verify-by-request`), второй ключ этого обхода не
# заводится.
#
# Исходы: 0 — трейлеров атрибуции нет; 1 — есть (каждая строка названа номером);
# 2 — сообщение не прочитано (файла нет) — коммит останавливается и так.
# Доказательство инъекцией — `scripts/tooling-gate/inject.sh`, раздел commit-msg.
set -uo pipefail

ATTRIBUTION='Co-Authored-By|Claude-Session'

msg="${1:-}"
if [ -z "$msg" ] || [ ! -r "$msg" ]; then
    echo "commit-msg: файл сообщения «$msg» не прочитан — проверять нечего, коммит остановлен" >&2
    exit 2
fi

cc="$(git config --get core.commentChar 2>/dev/null || true)"
case "$cc" in
    ''|auto) cc='#' ;;
esac
cc="${cc:0:1}"

found="$(awk -v cc="$cc" -v re="^[[:space:]]*(${ATTRIBUTION})[[:space:]]*:" '
    BEGIN { re = tolower(re) }
    # Линия ножниц: git отрезает всё, что ниже неё, вместе с ней самой.
    index($0, cc " ------------------------ >8 ------------------------") == 1 { exit }
    tolower($0) ~ re { printf "  строка %d: %s\n", NR, $0; n++ }
    END { exit (n > 0) ? 1 : 0 }
' "$msg")"
rc=$?

if [ "$rc" -eq 1 ]; then
    echo "commit-msg: ОТКАЗ — трейлер атрибуции в сообщении (gi-no-attribution-trailers):" >&2
    printf '%s\n' "$found" >&2
    echo "  Подпись берётся из git-config репозитория; уберите строки выше и повторите коммит." >&2
    exit 1
fi
if [ "$rc" -ne 0 ]; then
    echo "commit-msg: разбор сообщения не выполнился (awk, код $rc) — коммит остановлен" >&2
    exit 2
fi
# Без находок хук молчит: печать на каждом коммите перестала бы читаться. Когда
# осматривать нечего (в сообщении нет ни одной строки вне комментария), это
# сказано отдельно — «ноль находок» не то же, что «ноль прочитанного». Коммит в
# этом случае останавливает сам git (пустое сообщение), хук его не решает.
content="$(awk -v cc="$cc" '
    index($0, cc " ------------------------ >8 ------------------------") == 1 { exit }
    substr($0, 1, 1) == cc { next }
    /[^[:space:]]/ { n++ }
    END { print n + 0 }
' "$msg")"
[ "$content" -gt 0 ] ||
    echo "commit-msg: в сообщении нет строк вне комментария — осматривать нечего" >&2
exit 0
