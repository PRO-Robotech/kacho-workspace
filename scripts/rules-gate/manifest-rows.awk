# РАЗБОР ТАБЛИЦЫ `.claude/rules/MANIFEST.md` — единственный в наборе.
#
# ЧТО ПЕЧАТАЕТ: по строке на разобранный ряд живой таблицы, поля через TAB:
#
#     <номер строки в файле> \t <имя правила> \t A|- \t H|- \t <кому закреплено>
#
# «A» — ячейка «включается действием» непуста, «H» — непуста ячейка «чем
# соблюдение держится»; прочерк на месте любой из них означает пустоту.
#
# ПЯТОЕ ПОЛЕ — СОДЕРЖИМОЕ, А НЕ ФЛАГ, и асимметрия здесь намеренная. Первые две
# ячейки нужны набору ровно тем, пусты они или нет: их текст читает человек, и
# никакая проверка по нему решений не принимает. Четвёртая ячейка («закреплено за
# агентами») называет ИМЕНА, и по ним сверяется привязка правило↔агент в обе
# стороны — значит разборщик обязан отдать их, иначе соседняя проверка завела бы
# ВТОРОЕ прочтение таблицы, а две копии грамматики расходятся молча (см. ниже).
# Пустота при этом всё равно решается ЗДЕСЬ: формы, пустые для человека
# (прочерк, `TODO`, пустой код-спан, неразрывный пробел), приводятся к пустой
# строке, и список этих форм остаётся в одном месте — `unnamed()`.
#
# ПОЧЕМУ ОДИН ФАЙЛ НА ВЕСЬ НАБОР, И ЭТО СМЕНА ПРЕЖНЕГО РЕШЕНИЯ. До 2026-09-13
# каждая проверка несла свой разбор, и в шапке снятого `check-03` это было названо
# решением: общий файл, писанный двумя полосами разом, — столкновение, которое
# ловится только на сборке волны. Довод был о ПИСАНИИ, а предмет здесь —
# ИСТИННОСТЬ: грамматика у таблицы одна, и две её копии суть два места об одном
# предмете. Расходятся такие копии молча и в ту сторону, где проверка перестаёт
# ловить: `check-01` сверял бы состав по одному прочтению таблицы, `check-03`
# судил бы полноту ячеек по другому, и строка, видимая одному и невидимая
# другому, не дала бы ни красного, ни вопроса. Правило то же и для проверок,
# заведённых после: таблицу читают ОТСЮДА, своего разбора не заводят.
#
# ЧТО СЧИТАЕТСЯ СТРОКОЙ ТАБЛИЦЫ. Строка ЖИВОЙ таблицы: начинается с `|`, первая
# ячейка — имя файла на `.md` (в обратных кавычках или без; ведущий путь
# `.claude/rules/` снимается). Шапка таблицы и разделитель под неё не подпадают —
# в них нет `.md`. Имя правила, названное В ПРОЗЕ, строкой таблицы НЕ является:
# иначе манифест не мог бы говорить о правилах ничего, кроме перечисления.
#
# ЖИВОЙ — значит НЕ внутри блока кода и НЕ внутри HTML-комментария, а `\|` внутри
# ячейки — её содержимое, а не граница. Все три формы законны и все три ловились
# на противнике (2026-09-07); каждая давала МАСКУ, а не ложную находку:
#   · пример строки в ```-фенсе (манифест документирует свою же форму)
#     зачитывался за живую строку и покрывал снятую;
#   · закомментированная строка объявлена автором снятой — и зачитывалась;
#   · `\|` — обязательная форма GFM для литеральной трубы, а держатели здесь суть
#     предикаты (`grep -E 'a|b'`), где труба обычна: разбиение по сырому `|`
#     съезжало колонками, и ПУСТОЙ держатель проходил незамеченным.
#
# ЯЧЕЙКА НОРМАЛИЗУЕТСЯ ДО СВЕРКИ С ЗАГЛУШКАМИ. Неразрывный пробел, пустой
# код-спан и прочерк в обратных кавычках человек читает как пустоту —
# распознаватель обязан читать так же; `TODO`/`FIXME` добавлены к заглушкам как
# обещание вместо предмета (ban #11). Каждая из четырёх форм проходила за
# названного держателя.
#
# ИСКЛЮЧЕНИЙ У РАЗБОРА НЕТ НИ ОДНОГО, и это правка 2026-09-13. Прежняя редакция
# пропускала строку про сам `MANIFEST.md`: он лежал в своде, но правилом не
# считался ни одной стороной. Теперь манифест — такой же файл корпуса, закреплённый
# за агентами наравне с остальными, и своя строка ему нужна ровно как всем.
#
# РЯД ОБЯЗАН НЕСТИ ЧЕТЫРЕ ЯЧЕЙКИ (`n >= 5` после разбиения по трубе), и это
# правка 2026-09-17: таблица получила колонку «закреплено за агентами». Ряд
# прежней, трёхколоночной формы под условие подпадает — разбиение даёт ровно
# пять полей, — и его четвёртая ячейка выходит ПУСТОЙ: правило объявлено, а кому
# оно грузится, не сказано. Это находка `check-03`, а не молчание, и порядок тут
# несущий: отсеки разборщик такой ряд, правило исчезло бы из объявления целиком,
# и переезд на новую форму проходил бы незамеченным по одной строке за раз.
# Ряд короче (две ячейки и меньше) не разбирается вовсе — тогда краснеет `check-01`
# «файла нет в объявлении», и это верно: такой ряд не называет ни действия, ни
# держателя, то есть строкой таблицы уже не является.
#
# Звать: LC_ALL=C awk -f manifest-rows.awk <MANIFEST.md>
# Локаль прибита ВЫЗЫВАЮЩИМ: сравнение имён ниже по течению байтовое, и разбор
# обязан отдавать байты, а не то, что о них думает ru_RU.UTF-8.

BEGIN { ESC = "\001"; NBSP = "\302\240"; OFS = "\t" }

function trim(s) { gsub(/^[[:space:]]+|[[:space:]]+$/, "", s); return s }

function norm(s) {
    gsub(ESC, "|", s)
    gsub(NBSP, " ", s)
    gsub(/`/, "", s)
    return trim(s)
}

function unnamed(s) {
    return (s == "" || s == "-" || s == "--" || s == "—" || s == "–" ||
            s == "?" || s == "??" || s == "..." || s == "…" ||
            s == "TBD" || s == "tbd" || s == "n/a" || s == "N/A" ||
            s == "TODO" || s == "todo" || s == "FIXME" || s == "fixme")
}

# Блок кода — НЕ таблица. Манифест документирует форму строки примером, и пример,
# зачтённый за живую строку, МАСКИРУЕТ снятую: правило выпадает из объявления, а
# гейт зелен.
/^[[:space:]]*(```|~~~)/ { fence = !fence; next }
fence { next }

# HTML-комментарий — тоже не таблица: закомментированная строка объявлена снятой,
# и зачитывать её значит не краснеть на снятии строки.
{
    line = $0
    if (incomment) {
        if (line ~ /-->/) { sub(/^.*-->/, "", line); incomment = 0 } else next
    }
    while (match(line, /<!--/)) {
        head = substr(line, 1, RSTART - 1)
        rest = substr(line, RSTART)
        if (match(rest, /-->/)) { line = head substr(rest, RSTART + 3) }
        else { line = head; incomment = 1; break }
    }
}

line ~ /^[[:space:]]*\|/ {
    gsub(/\\\|/, ESC, line)
    n = split(line, c, "|")
    if (n < 5) next
    name = norm(c[2]); act = norm(c[3]); hold = norm(c[4]); bind = norm(c[5])
    sub(/^\.claude\/rules\//, "", name)
    if (name !~ /\.md$/) next
    print NR, name, (unnamed(act) ? "-" : "A"), (unnamed(hold) ? "-" : "H"), \
          (unnamed(bind) ? "" : bind)
}
