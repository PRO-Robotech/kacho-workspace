              "kind",
              "repository",
              "state",
              "tag_ref",
              "expected_sha",
              "sha",
              "release_id"
            ],
            "properties": {
              "kind": {
                "const": "release-note"
              },
              "repository": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
              },
              "state": {
                "enum": [
                  "PRESENT",
