  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PRO-Robotech/kacho-workspace/docs/changes/ci-release-supply/result.schema.json",
  "title": "CI-RS-1 proposed result schema - DRAFT",
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "GREEN"
          }
        }
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 0
          },
          "reason": {
            "const": "OK"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "RED"
          }
        }
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "USAGE_ERROR"
          }
        }
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 2
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "NOT_EXECUTED"
          }
        }
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 3
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "dry_run": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "effects": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "enum": [
              "RED",
              "USAGE_ERROR",
              "NOT_EXECUTED"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "not": {
              "const": "OK"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "GREEN"
          }
        }
      },
      "then": {
        "properties": {
          "effects": {
            "items": {
              "properties": {
                "state": {
                  "const": "PRESENT"
                }
              }
            }
          }
        }
      }
    }
  ]
}
