{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "phase",
    "outcome",
    "reason",
    "exit_code",
    "dry_run",
    "stage",
    "repository",
    "version",
    "plan_sha256",
    "input_sha256",
    "candidate_sha",
    "tag_target_sha",
    "snapshots",
    "census",
    "checks",
    "effects"
