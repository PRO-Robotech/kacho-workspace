  "properties": {
    "schema_version": {
      "const": 1
    },
    "phase": {
      "enum": [
        "plan",
        "deliver",
        "release",
        "probe",
        "candidate",
        "consumers",
        "pins"
      ]
    },
    "outcome": {
      "enum": [
        "GREEN",
        "RED",
        "USAGE_ERROR",
        "NOT_EXECUTED"
      ]
    },
    "reason": {
      "enum": [
        "OK",
        "INVALID_INVOCATION",
        "INVALID_CONFIRMATION",
        "REPOSITORY_MISMATCH",
        "INPUT_INVALID",
        "INPUT_CHANGED",
        "UNDECLARED_PATH_LOSS",
        "RECEIVING_OWNERSHIP_CONFLICT",
        "BASELINE_EMPTY",
        "BASELINE_STALE",
        "BASELINE_UNAVAILABLE",
        "PACKAGE_FLOOR_LOSS",
        "CONSUMER_IMPORT_MISSING",
        "CONSUMER_CENSUS_EMPTY",
        "CONSUMER_DECLARATION_INVALID",
        "SOURCE_UNAVAILABLE",
        "PR_REQUIRED",
        "TARGET_NOT_ON_MAIN",
        "CONTENT_MISMATCH",
        "REQUIRED_CHECKS_FAILED",
        "BUDGET_EXHAUSTED",
        "PROXY_UNAVAILABLE",
        "PUBLISHED_ARCHIVE_MISMATCH",
        "CONSUMER_BUILD_FAILED",
        "PIN_UNREACHABLE",
        "PIN_NOT_ON_MAIN",
        "MODULE_CENSUS_EMPTY",
        "INTERNAL_CENSUS_EMPTY",
        "MODULE_MAPPING_INVALID",
        "TAG_IDENTITY_CONFLICT",
        "WRITE_OUTCOME_UNKNOWN",
        "PAYLOAD_MISMATCH",
        "PR_HEAD_CHANGED",
        "VERSION_INVALID",
        "COMPATIBILITY_FAILED",
        "HARNESS_UNAVAILABLE",
        "REMOTE_WRITE_REJECTED",
        "EFFECT_IDENTITY_CONFLICT"
      ]
    },
    "exit_code": {
      "enum": [
        0,
        1,
        2,
        3
      ]
    },
    "dry_run": {
      "type": "boolean"
    },
    "stage": {
      "enum": [
        "NONE",
        "BRANCH_PRESENT",
        "PR_OPEN",
        "MERGE_PRESENT",
        "MERGED_VERIFIED",
        "TAG_PRESENT",
        "ARCHIVE_VERIFIED"
      ]
    },
    "repository": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "version": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "plan_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "input_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "candidate_sha": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "tag_target_sha": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "snapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "point",
          "main_sha",
          "observed_at",
          "target_is_ancestor"
        ],
        "properties": {
          "point": {
            "enum": [
              "base",
              "pre-write",
              "post-write"
            ]
          },
          "main_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "target_is_ancestor": {
            "type": "boolean"
          }
        }
      }
    },
    "census": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_files",
        "preserved_files",
        "previous_packages",
        "candidate_packages",
        "consumers",
        "consumer_imports",
        "modules",
        "internal_requirements",
        "pseudo_versions",
        "resolved_pins",
        "required_checks",
        "payload_files"
