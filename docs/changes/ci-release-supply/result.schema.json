                "pattern": "^[0-9a-f]{40}$"
              },
              "pr_number": {
                "type": "integer",
                "minimum": 1
              },
              "sha": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                  },
