filters:
  and:
    - file.hasTag("kac")
    - 'file.ext == "md"'

formulas:
  # Статусы, которые формула НЕ знает, показываются как "[?]" и — что важнее —
  # проходят фильтр вида "Active" (он исключает только done/wontfix). То есть
  # запиской с неизвестным статусом вид отчитывается как об открытой работе.
  #
  # Это не гипотеза: 2026-08-05 в каталоге нашлась ровно одна такая запись —
  # `status: retired` у KAC-186, которая описывала СНЯТЫЙ механизм и при этом
  # показывалась виду как активная работа. Ловил её не этот файл, а проверка
  # `scripts/vault-gate/check-03-note-shell.sh` (словарь состояний она выводит из
  # obsidian/kacho/CLAUDE.md, а не из рукописного списка внутри себя). Здесь такой
  # проверки нет и быть не может — .base ничего не исполняет; значит два набора
  # ниже держатся дисциплиной, и расхождение поймает check-03, а не вид.
  #
  # Статусы, реально встречающиеся в каталоге на 2026-08-05 (207 записок):
  #   done 159 · in-progress 15 · superseded 15 · reference 8 · test 3 ·
  #   planned 3 · wontfix 2 · to-do 1 · без поля 1 (README, у витрины предмета нет).
  # Все восемь значений формула знает; в "Active" попадает 22, минус _TEMPLATE = 21.
  # Поэтому набор здесь и набор в §"Active" ниже обязаны меняться ВМЕСТЕ.
  # superseded — предмет поглощён другой работой или снят с продукта решением;
  # reference  — отчёт раунда / методика: не единица работы, закрывать нечего.
  status_icon: 'if(status == "done", "[done]", if(status == "in-progress", "[wip]", if(status == "test", "[test]", if(status == "wontfix", "[wontfix]", if(status == "superseded", "[superseded]", if(status == "reference", "[reference]", if(status == "to-do", "[to-do]", if(status == "planned", "[planned]", "[?]")))))))'
  repo_count: 'if(repos, repos.length, 0)'

properties:
  ticket_id:
    displayName: ID
  formula.status_icon:
    displayName: Status
  type:
    displayName: Type
  formula.repo_count:
    displayName: "# repos"
  yt_url:
    displayName: YouTrack
  file.mtime:
    displayName: Updated

views:
  - type: table
    name: All tickets
    filters:
      not:
        - 'file.name == "_TEMPLATE"'
        - 'file.name == "README"'
    order:
      - ticket_id
      - file.name
      - formula.status_icon
      - type
      - formula.repo_count
      - file.mtime
    groupBy:
      property: status
      direction: ASC

  # "Active" = то, по чему кто-то обязан двигаться. Всё, у чего исхода уже не будет,
  # исключается ЯВНО: done (сделано) · wontfix (отказались) · superseded (предмет
  # поглощён/снят) · reference (отчёт раунда, не единица работы). Заводя новый
  # статус — впиши его и сюда, и в formulas.status_icon, иначе вид молча начнёт
  # называть закрытое открытым.
  - type: table
    name: Active
    filters:
      and:
        - 'status != "done"'
        - 'status != "wontfix"'
        - 'status != "superseded"'
        - 'status != "reference"'
      not:
        - 'file.name == "_TEMPLATE"'
        - 'file.name == "README"'
    order:
      - ticket_id
      - file.name
      - type
      - formula.repo_count
      - file.mtime

  - type: table
    name: Epics
    filters:
      and:
        - 'type == "epic"'
    order:
      - ticket_id
      - file.name
      - status
      - formula.repo_count
      - file.mtime
