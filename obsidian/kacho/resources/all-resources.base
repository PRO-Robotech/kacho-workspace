filters:
  and:
    - file.hasTag("resource")
    - 'file.ext == "md"'

# Свойство переименовано folder_level → project_level (2026-08-05): «папки» как
# уровня иерархии не существует — её преемник проект iam, и колонка-владелец в каждом
# сервисе называется project_id. Формула переехала вместе со свойством в том же
# изменении: иначе она молча вычисляла бы «global» для КАЖДОЙ записки, и срез Scope
# выглядел бы работающим.
formulas:
  scope_label: 'if(project_level, "project-level", "global")'

properties:
  domain:
    displayName: Domain
  id_prefix:
    displayName: ID prefix
  owner_table:
    displayName: Owner table
  formula.scope_label:
    displayName: Scope
  visibility:
    displayName: Visibility
  status:
    displayName: Status

views:
  - type: table
    name: All resources
    order:
      - file.name
      - domain
      - id_prefix
      - owner_table
      - formula.scope_label
      - visibility
      - status
    groupBy:
      property: domain
      direction: ASC

  - type: table
    name: VPC
    filters:
      and:
        - 'domain == "vpc"'
    order:
      - file.name
      - id_prefix
      - owner_table
      - formula.scope_label
      - visibility

  # Здесь стоял именной срез по снятому домену — он показывал его наравне с
  # действующими. Заменён на срез по статусу: снятое находится по канону статуса,
  # какой бы домен ни сняли следующим, а мёртвый домен перестаёт быть фасетом.
  - type: table
    name: Deprecated
    filters:
      and:
        - 'status == "deprecated"'
    order:
      - file.name
      - domain
      - status

  - type: cards
    name: Cards
    order:
      - file.name
      - domain
      - id_prefix
      - formula.scope_label
