filters:
  and:
    - file.hasTag("resource")
    - 'file.ext == "md"'

formulas:
  folder_label: 'if(folder_level, "folder-level", "global")'

properties:
  domain:
    displayName: Domain
  id_prefix:
    displayName: ID prefix
  owner_table:
    displayName: Owner table
  formula.folder_label:
    displayName: Scope
  visibility:
    displayName: Visibility
  status:
    displayName: Status

views:
  - type: table
    name: All resources
    order:
      - file.name
      - domain
      - id_prefix
      - owner_table
      - formula.folder_label
      - visibility
      - status
    groupBy:
      property: domain
      direction: ASC

  - type: table
    name: VPC
    filters:
      and:
        - 'domain == "vpc"'
    order:
      - file.name
      - id_prefix
      - owner_table
      - formula.folder_label
      - visibility

  # Здесь стоял именной срез по снятому домену — он показывал его наравне с
  # действующими. Заменён на срез по статусу: снятое находится по канону статуса,
  # какой бы домен ни сняли следующим, а мёртвый домен перестаёт быть фасетом.
  - type: table
    name: Deprecated
    filters:
      and:
        - 'status == "deprecated"'
    order:
      - file.name
      - domain
      - status

  - type: cards
    name: Cards
    order:
      - file.name
      - domain
      - id_prefix
      - formula.folder_label
